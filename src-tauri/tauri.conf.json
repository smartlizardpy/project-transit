{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Project Transit",
  "version": "0.2.1",
  "identifier": "dev.projecttransit.prototype",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm build:mcp && pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm build:mcp"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Transit",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#ebe8e0",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.openfreemap.org https://nominatim.openstreetmap.org"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SimulationGame",
    "shortDescription": "Project Transit: run a bus company in a real city",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../dist-mcp/project-transit-mcp.mjs": "mcp/project-transit-mcp.mjs"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NDMwNERDNDA3RTkwMzcKUldRM2tINUEzQVJEOW1PMFNhTzg4TytDQjI5ZE5CZWFPeDBZbC9ubFE1cDM1VEZFY1ZXUy9Fci8K",
      "endpoints": [
        "https://github.com/smartlizardpy/project-transit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
