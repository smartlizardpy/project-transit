{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Project Transit",
  "version": "0.1.0",
  "identifier": "dev.projecttransit.prototype",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Transit",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#ebe8e0",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.openfreemap.org"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SimulationGame",
    "shortDescription": "Project Transit \u2014 design prototype"
  }
}